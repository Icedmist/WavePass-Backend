DATABASE_URL=postgresql://user:pass@localhost:5432/wavepass
DIRECT_DATABASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Single platform (Nexa) key — cashouts settle from this account to venue banks.
# Preferred bank for per-venue DVA number allocation (e.g. wema-bank).
PAYSTACK_DVA_BANK=wema-bank
# Admin authorisation for cashouts. Provide ADMIN_PASSWORD_HASH (sha256 hex) in
# production; a plain ADMIN_PASSWORD is hashed at boot as a convenience fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

REDIS_URL=redis://localhost:6379

APP_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3001

JWT_SECRET=
ENCRYPTION_KEY=

MIKROTIK_API_USER=wavepass
MIKROTIK_API_PASS=
MIKROTIK_DEFAULT_TIMEOUT_MS=10000
MIKROTIK_MAX_RETRIES=8

SENTRY_DSN=
PORT=3000
